# Samsung Galaxy Tab S5e (gts4lvwifi): U-Boot in the recovery partition, Linux as a FIT
# further into it (see gts4lv.env). Quiet: Samsung's splash stays until the menu is asked for.
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/gts4lv.env"
CONFIG_NO_FB_CLEAR=y
# The menu's Android entry clears the bootloader message in misc.
CONFIG_CMD_BCB=y
CONFIG_CMD_POWEROFF=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_FDT=y
CONFIG_CMD_PART=y
