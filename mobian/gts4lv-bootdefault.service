[Unit]
Description=Keep Debian the default boot (bootloader message in misc)
DefaultDependencies=no
After=local-fs.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gts4lv-bootdefault
ExecStop=/usr/local/sbin/gts4lv-bootdefault

[Install]
WantedBy=multi-user.target
