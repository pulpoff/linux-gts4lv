<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="de.gts4lv.boot-android">
    <description>Restart into Android</description>
    <message>Authentication is required to restart into Android</message>
    <icon_name>de.gts4lv.BootAndroid</icon_name>
    <defaults>
      <!-- like an ordinary restart: the user at the tablet may, others must authenticate -->
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/gts4lv-boot-android</annotate>
  </action>
</policyconfig>
